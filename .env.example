# TSS Wallet Backend - Environment Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
ENVIRONMENT=development  # development | production

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=tss_wallet
DB_PASSWORD=tss_wallet_secret
DB_NAME=tss_wallet_db
DB_SSL_MODE=disable  # disable | require | verify-full

# =============================================================================
# REDIS CONFIGURATION (Relay Server)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# AUTHENTICATION (JWT)
# =============================================================================
# IMPORTANT: Change this in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE_HOURS=24

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_RPS=10     # Requests per second
RATE_LIMIT_BURST=20   # Burst size

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
WS_PING_INTERVAL=30       # Ping interval in seconds
WS_PONG_TIMEOUT=10        # Pong timeout in seconds
WS_WRITE_TIMEOUT=10       # Write timeout in seconds
WS_MAX_MESSAGE_SIZE=65536 # Max message size in bytes (64KB)

# =============================================================================
# RELAY SERVER CONFIGURATION
# =============================================================================
RELAY_MESSAGE_TTL=3600       # Message TTL in seconds (1 hour)
RELAY_SESSION_TTL=86400      # Session TTL in seconds (24 hours)
RELAY_DEVICE_TTL=604800      # Device registration TTL in seconds (7 days)
RELAY_CLEANUP_INTERVAL=300   # Cleanup interval in seconds (5 minutes)

# =============================================================================
# LEGACY MODE (DEPRECATED - MVP only)
# =============================================================================
# WARNING: Legacy mode runs TSS on the server, which is INSECURE for production.
# The server has access to ALL key shares and can sign without user consent.
# Set to false in production to disable /keygen/* and /signing/* endpoints.
LEGACY_MODE_ENABLED=true     # Set to false to disable legacy endpoints

# =============================================================================
# DOCKER COMPOSE (Optional overrides)
# =============================================================================
# These are used when running with docker-compose
# COMPOSE_PROJECT_NAME=tss-wallet
