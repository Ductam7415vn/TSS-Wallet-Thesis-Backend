# TSS Wallet Backend - Environment Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
ENVIRONMENT=development  # development | production

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=tss_wallet
DB_PASSWORD=tss_wallet_secret
DB_NAME=tss_wallet_db
DB_SSL_MODE=disable  # disable | require | verify-full

# =============================================================================
# AUTHENTICATION (JWT)
# =============================================================================
# IMPORTANT: Change this in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE_HOURS=24

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_RPS=10     # Requests per second
RATE_LIMIT_BURST=20   # Burst size

# =============================================================================
# DOCKER COMPOSE (Optional overrides)
# =============================================================================
# These are used when running with docker-compose
# COMPOSE_PROJECT_NAME=tss-wallet
